---
import Document from './Document.astro';
import Navigation from '@/src/components/Navigation.astro';
import Footer from '@/src/components/Footer.astro';
import { cases } from '@/src/cases';
const {item} = Astro.props as {item:typeof cases[number]};
const url = `https://calvocreativo.com/casos/${item.slug}`;
const image = `https://calvocreativo.com/api/og?title=${encodeURIComponent(item.title)}`;
const schema = {'@context':'https://schema.org','@graph':[
 {'@type':'Article','@id':`${url}#article`,headline:item.title,description:item.summary,image,inLanguage:'es',mainEntityOfPage:url,author:{'@id':'https://calvocreativo.com/#roger'},publisher:{'@id':'https://calvocreativo.com/#organization'},datePublished:'2026-10-12',dateModified:'2026-10-12'},
 {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Inicio',item:'https://calvocreativo.com'},{'@type':'ListItem',position:2,name:'Trabajos y casos',item:'https://calvocreativo.com/casos'},{'@type':'ListItem',position:3,name:item.client,item:url}]}
]};
---
<Document><Fragment slot="head"><title>{item.client} | Caso de Calvo Creativo</title><meta name="description" content={item.summary}/><link rel="canonical" href={url}/><meta property="og:type" content="article"/><meta property="og:title" content={item.title}/><meta property="og:description" content={item.summary}/><meta property="og:url" content={url}/><meta property="og:image" content={image}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content={image}/><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')}/></Fragment>
<Navigation/><main><article>
<header class="max-w-5xl mx-auto px-6 py-14 md:py-20"><nav aria-label="Ruta de navegación" class="font-mono text-xs mb-8"><a href="/">Inicio</a> / <a href="/casos" class="underline">Trabajos y casos</a> / <span aria-current="page">{item.client}</span></nav><p class="font-mono uppercase text-primary mb-4">{item.category}</p><h1 class="font-display text-4xl md:text-6xl leading-tight mb-6">{item.title}</h1><p class="text-xl text-gray-700 leading-relaxed max-w-3xl">{item.summary}</p><p class="font-mono text-sm mt-6">Por <a href="/autor/roger-murillo" class="underline">Roger Murillo · Calvo Creativo</a></p>{item.website && <a href={item.website} target="_blank" rel="noopener noreferrer" class="inline-block mt-6 border-2 border-ink px-5 py-3 font-bold hover:bg-ink hover:text-white">Visitar el proyecto ↗</a>}</header>
<div class="bg-ink text-white py-10 px-6"><div class="max-w-5xl mx-auto"><p class="font-display text-5xl text-accent">{item.signal}</p><p class="mt-3 text-lg">{item.label}</p></div></div>
<div class="max-w-4xl mx-auto px-6 py-14 space-y-14">
<section><h2 class="font-display text-3xl mb-5">El punto de partida</h2><p class="text-lg leading-relaxed">{item.problem}</p></section>
<section><h2 class="font-display text-3xl mb-6">Las decisiones que tomamos</h2><div class="space-y-8">{item.decisions.map(([title,text]: readonly [string,string],index: number) => <div><h3 class="font-bold text-xl mb-3">{index+1}. {title}</h3><p class="text-lg leading-relaxed text-gray-700">{text}</p></div>)}</div></section>
<section><h2 class="font-display text-3xl mb-5">El resultado</h2><p class="text-lg leading-relaxed">{item.result}</p><div class="mt-6 border-l-4 border-primary bg-white p-6"><h3 class="font-bold text-lg mb-3">Cómo leer los resultados</h3><p class="leading-relaxed text-gray-700">{item.measurement}</p></div></section>
<section><h2 class="font-display text-3xl mb-5">Lo que aprendimos</h2><p class="text-xl leading-relaxed">{item.lesson}</p><a href={item.service} class="inline-block mt-6 font-bold underline decoration-primary underline-offset-4">Hablemos de un proyecto similar →</a></section>
<section class="border-t-2 border-ink pt-8"><h2 class="font-display text-3xl mb-5">Otros trabajos</h2><ul class="space-y-4">{cases.filter(other => other.slug!==item.slug).map(other => <li><a href={`/casos/${other.slug}`} class="underline underline-offset-4">{other.client} →</a></li>)}</ul><a href="/casos" class="inline-block mt-6 font-bold">Ver todos los trabajos →</a></section>
</div></article></main><Footer/></Document>


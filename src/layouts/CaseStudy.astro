---
import Document from './Document.astro';
import Navigation from '@/src/components/Navigation.astro';
import Footer from '@/src/components/Footer.astro';
import { cases } from '@/src/cases';
import CaseExplorer from '@/src/components/CaseExplorer.astro';
import AlbumCover from '@/src/components/AlbumCover.astro';
import CaseWorkGallery from '@/src/components/CaseWorkGallery.astro';
const {item} = Astro.props as {item:typeof cases[number]};
const url = `https://calvocreativo.com/casos/${item.slug}`;
const image = `https://calvocreativo.com/api/og?title=${encodeURIComponent(item.title)}`;
const stories = {
 'german-montenegro': {hook:'Sabe dónde le duele. No cómo se llama.',insight:'La auditoría y la investigación SEO llevaron a una decisión de experiencia: empezar por el síntoma y la zona del cuerpo.',explore:'Del «me duele aquí» al siguiente paso.',question:'¿Y si la web no exigiera conocer el nombre de la lesión?',proof:'Intención de búsqueda aplicada a la UX',image:'/images/case-german-body.webp',stats:[['Síntoma','el lenguaje de entrada'],['Cuerpo 3D','navegación por zonas'],['23 páginas','arquitectura documentada']]},
 'rogermurillo': {hook:'Una web a la altura de su autoridad.',insight:'De un WordPress lento y problemático a una base propia que conecta rendimiento, búsquedas y negocio.',explore:'Las personas ya están levantando la mano.',question:'¿Cómo recuperar una web que frenaba una marca con experiencia?' ,proof:'Solicitudes documentadas',image:'/images/case-roger-web.jpg',stats:[['37','solicitudes registradas'],['23','envíos con intereses de imagen'],['26 jul–12 oct','período de 2026']]},
 'all-claims': {hook:'Su operación. Su propio CRM.',insight:'De Excel y carpetas de OneDrive a una herramienta compartida que ya utiliza la empresa y sus colaboradores.',explore:'De guardar archivos a trabajar en un sistema.',question:'¿Cómo dejar de reconstruir cada caso entre archivos y carpetas?',proof:'CRM en uso · Confirmado por el responsable',image:'',stats:[['CRM propio','empresa y colaboradores'],['Agenda + correos','automatización diaria'],['Contratos','intake y revisión en beta']]},
 'prendaautos': {hook:'Más intención. El mismo presupuesto.',insight:'Una web renovada y campañas que pasan de buscar clics a medir contactos. Cinco o seis meses de trabajo continuo con la clienta.',explore:'Diseño, confianza y campañas con criterio.',question:'¿Cómo conectar una campaña de clics con la necesidad real del cliente?' ,proof:'Comparación de campaña',image:'',stats:[['−56%','costo por acción en carros'],['2,84','acciones de carros por día'],['71','acciones en el segundo período']]},
};
const story = stories[item.slug];
const chapters = [['reto','El reto'],['explorar','Explorar el trabajo'],['decisiones','Las decisiones'],['evidencia','La evidencia']];
const schema = {'@context':'https://schema.org','@graph':[
 {'@type':'Article','@id':`${url}#article`,headline:item.title,description:item.summary,image,inLanguage:'es',mainEntityOfPage:url,author:{'@id':'https://calvocreativo.com/#roger'},publisher:{'@id':'https://calvocreativo.com/#organization'},datePublished:'2026-10-12',dateModified:'2026-10-13'},
 {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Inicio',item:'https://calvocreativo.com'},{'@type':'ListItem',position:2,name:'Trabajos y casos',item:'https://calvocreativo.com/casos'},{'@type':'ListItem',position:3,name:item.client,item:url}]}
]};
---
<Document><Fragment slot="head"><title>{item.client} | Caso de Calvo Creativo</title><meta name="description" content={item.summary}/><link rel="canonical" href={url}/><meta property="og:type" content="article"/><meta property="og:title" content={item.title}/><meta property="og:description" content={item.summary}/><meta property="og:url" content={url}/><meta property="og:image" content={image}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content={image}/><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')}/></Fragment>
<Navigation />
<main class="case-story" data-case-story>
  <article>
    <header class="case-hero">
      <div class="case-shell">
        <nav aria-label="Ruta de navegación" class="case-breadcrumb"><a href="/">Inicio</a><span>/</span><a href="/casos">Trabajos y casos</a><span>/</span><span aria-current="page">{item.client}</span></nav>
        <div class="hero-columns">
          <div>
            <p class="case-kicker"><span class="live-dot" aria-hidden="true"></span>{item.client}</p>
            <h1>{story.hook}</h1>
            <p class="hero-deck">{story.insight}</p>
            <p class="hero-discipline">{item.category}</p>
            <a class="case-action" href="#explorar">Explorar lo que hicimos <span aria-hidden="true">↘</span></a>
          </div>
          <div class="hero-art">
            <AlbumCover slug={item.slug} priority />
            <div class="proof-tag"><span aria-hidden="true">↳</span><div><strong>{item.signal}</strong><p>{story.proof}</p></div></div>
          </div>
        </div>
        <div class="case-stats">{story.stats.map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}</div>
      </div>
    </header>
    <nav class="chapter-nav" aria-label="Capítulos del caso"><div class="case-shell">{chapters.map(([id,label],index)=><a href={`#${id}`} data-chapter-link={id}><span>0{index+1}</span>{label}</a>)}</div><div class="reading-track" aria-hidden="true"><span data-reading-progress></span></div></nav>
    <div class="case-shell story-body">
      <section id="reto" data-chapter class="story-section challenge-section">
        <div><p class="section-index">01 / El reto</p><h2>{story.question}</h2></div>
        <div class="challenge-copy"><p>{item.problem}</p><div class="challenge-turn"><span aria-hidden="true">↳</span><p>La decisión inicial: {item.decisions[0][0].toLowerCase()}.</p></div></div>
      </section>
      <section id="explorar" data-chapter class="story-section explorer-section">
        <div class="section-intro"><p class="section-index">02 / Explorar el trabajo</p><h2>{story.explore}</h2><p>Primero mira el proyecto. Después explora las decisiones y los resultados.</p></div>
        <CaseWorkGallery slug={item.slug} />
        <CaseExplorer slug={item.slug} />
        {item.slug==='german-montenegro' && <div class="feature-note"><span aria-hidden="true">↗</span><div><h3>El cuerpo nace de una pregunta SEO.</h3><p>¿Cómo llega al contenido alguien que sabe dónde le duele, pero no conoce el término técnico? La respuesta fue ofrecer una entrada por zonas. El recorrido completo busca unir orientación, explicación del especialista y contacto.</p><a href="https://germanmontenegro.fit" target="_blank" rel="noopener noreferrer">Explorar el cuerpo en la web real ↗</a></div></div>}
      </section>
      <section id="decisiones" data-chapter class="story-section">
        <div class="section-intro"><p class="section-index">03 / Las decisiones</p><h2>Lo que hizo que el proyecto tomara forma.</h2><p>Abre cada decisión para ver el razonamiento detrás de la implementación.</p></div>
        <div class="decision-list">{item.decisions.map(([title,text]:readonly [string,string],index:number)=><details open={index===0}><summary><span class="decision-number">0{index+1}</span><h3>{title}</h3><span class="decision-toggle" aria-hidden="true">+</span></summary><div class="decision-content"><p>{text}</p></div></details>)}</div>
      </section>
      <section id="evidencia" data-chapter class="story-section evidence-section">
        <div class="section-intro"><p class="section-index">04 / La evidencia</p><h2>Lo que podemos demostrar.</h2></div>
        <div class="evidence-grid"><div class="evidence-result"><span class="evidence-label">{story.proof}</span><p class="evidence-number">{item.signal}</p><p>{item.result}</p>{item.website && <a href={item.website} target="_blank" rel="noopener noreferrer">Comprobar el proyecto real ↗</a>}</div><aside class="evidence-scope"><h3>Fuente y alcance</h3><p>{item.measurement}</p></aside></div>

        <div class="takeaway"><span class="section-index">El aprendizaje</span><p>{item.lesson}</p></div>
      </section>
      <section class="case-closing"><p class="case-kicker">Del caso a tu negocio</p><h2>¿Qué problema necesitas resolver?</h2><p>Cuéntame en qué punto estás. Empecemos por entenderlo.</p><a href="/contacto" class="case-action">Hablemos de tu proyecto <span aria-hidden="true">↗</span></a><a href={item.service} class="service-link">Ver el servicio relacionado →</a><div class="case-author">Estrategia e implementación por <a href="/autor/roger-murillo">Roger Murillo · Calvo Creativo</a></div></section>
      <section class="other-cases"><div><p class="section-index">Sigue explorando</p><h2>Otro problema. Otra historia.</h2></div><div class="other-case-grid">{cases.filter(other=>other.slug!==item.slug).map(other=><a href={`/casos/${other.slug}`}><span>{other.category}</span><h3>{other.client}</h3><p>{other.signal}</p><span class="other-arrow" aria-hidden="true">↗</span></a>)}</div><a href="/casos" class="all-cases-link">Todos los trabajos →</a></section>
    </div>
  </article>
</main>
<Footer />
</Document>
<script>
 const story=document.querySelector<HTMLElement>('[data-case-story]');
 if(story){
   const chapters=Array.from(story.querySelectorAll<HTMLElement>('[data-chapter]'));
   const links=Array.from(story.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]'));
   const progress=story.querySelector<HTMLElement>('[data-reading-progress]');
   let ticking=false;
   const update=()=>{
     const siteNav=story.previousElementSibling as HTMLElement | null;
     if(siteNav?.tagName === "NAV")story.style.setProperty("--case-nav-top",`${siteNav.offsetHeight}px`);
     let active=chapters[0]?.id;
     chapters.forEach(chapter=>{if(chapter.getBoundingClientRect().top<=210)active=chapter.id;});
     links.forEach(link=>{if(link.dataset.chapterLink===active)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');});
     if(progress){const rect=story.getBoundingClientRect();const length=Math.max(1,rect.height-window.innerHeight);progress.style.width=`${Math.min(100,Math.max(0,-rect.top/length*100))}%`;}
     ticking=false;
   };
   window.addEventListener('scroll',()=>{if(!ticking){ticking=true;requestAnimationFrame(update);}},{passive:true});
   window.addEventListener('resize',update);update();
 }
</script>
<style>
 .case-story{--case-acid:#c7fa72;--case-dark:#111512;--case-muted:#aab5ab;background:#f5f4ed;color:#181d19;font-family:'Outfit Variable',sans-serif}
 .case-shell{max-width:1200px;margin:0 auto;padding-inline:clamp(22px,5vw,64px)}
 .case-hero{background:var(--case-dark);color:#f5f4ed;padding:32px 0 0}.case-breadcrumb{display:flex;flex-wrap:wrap;gap:12px;font:10px 'JetBrains Mono Variable',monospace;color:#bcc6bd;line-height:1.8;margin-bottom:58px}.case-breadcrumb a:hover{color:var(--case-acid)}
 .hero-columns{display:grid;grid-template-columns:1.1fr 1fr;gap:56px;align-items:center}.case-kicker{font:11px 'JetBrains Mono Variable',monospace;text-transform:uppercase;letter-spacing:.1em;display:flex;align-items:center;gap:12px}.live-dot{width:7px;height:7px;background:#e11d48;display:inline-block;border-radius:50%;box-shadow:0 0 0 5px #e11d4820}
 h1{font-size:clamp(46px,5.7vw,76px);font-weight:550;line-height:1.03;letter-spacing:-.045em;margin:26px 0}.hero-deck{font-size:20px;line-height:1.6;color:#c2cbc3;max-width:540px}.hero-discipline{color:var(--case-acid);font:10px 'JetBrains Mono Variable',monospace;text-transform:uppercase;letter-spacing:.04em;margin-top:24px}.case-action{display:inline-flex;align-items:center;justify-content:space-between;gap:32px;background:var(--case-acid);color:#111512;border-radius:4px;padding:17px 22px;min-height:52px;margin-top:30px;font-weight:600;transition:background .2s,transform .2s}.case-action:hover{background:#dafcaa;transform:translateY(-2px)}
 .hero-art{position:relative;padding:18px 0 32px}.project-window{border:1px solid #536251;border-radius:10px;background:#222b23;overflow:hidden;transform:rotate(-2deg);box-shadow:0 30px 60px #0005;transition:transform .25s}.project-window:hover{transform:rotate(0)}.window-top{display:flex;justify-content:space-between;gap:8px;padding:12px;font:9px 'JetBrains Mono Variable',monospace;color:#c0cdc1}.window-top>span:first-child{letter-spacing:3px;color:#728170}.project-window img{width:100%;height:auto;aspect-ratio:1.38;object-fit:cover;object-position:top;display:block}.project-window figcaption{font:9px 'JetBrains Mono Variable',monospace;color:#c0cdc1;padding:12px}.proof-tag{position:relative;margin:-5px -8px 0 30px;background:var(--case-acid);color:#111512;padding:20px 24px;display:flex;gap:20px;box-shadow:0 16px 30px #0002;transform:rotate(2deg);border-radius:5px}.proof-tag>span{font-size:30px}.proof-tag strong{font-size:26px;font-weight:650}.proof-tag p{font-size:11px;margin-top:4px;text-transform:uppercase;letter-spacing:.04em}
 .case-stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #354236;margin-top:60px}.case-stats>div{padding:30px 20px 30px 0;display:flex;flex-direction:column;gap:12px}.case-stats>div+div{padding-left:28px;border-left:1px solid #354236}.case-stats strong{font-size:clamp(25px,4vw,46px);font-weight:500;letter-spacing:-.04em;line-height:1.1}.case-stats span{font:10px 'JetBrains Mono Variable',monospace;color:#c2cbc3;line-height:1.6}
 .hero-diagram{border:1px solid #455544;border-radius:14px;padding:34px 28px;background:linear-gradient(145deg,#243123,#141b15)}.hero-diagram>p:first-child{font:10px 'JetBrains Mono Variable',monospace;text-transform:uppercase;color:var(--case-acid)}.hero-number{font-size:clamp(30px,4vw,48px);font-weight:500;margin:36px 0 12px;white-space:nowrap;letter-spacing:-.045em}.hero-number span{color:var(--case-acid)}.hero-bar{height:12px;background:#8f9d8e;margin:24px 0;border-radius:5px}.hero-bar>span{width:44%;height:100%;display:block;background:var(--case-acid);border-radius:5px}.diagram-note{color:#bdc9bd;font-size:11px;line-height:1.7;margin-top:26px}.crm-orbit{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:28px;counter-reset:step}.crm-orbit span{counter-increment:step;border:1px solid #596954;border-radius:9px;padding:20px 14px;font-size:15px}.crm-orbit span:before{content:'0' counter(step);display:block;color:var(--case-acid);font:10px 'JetBrains Mono Variable',monospace;margin-bottom:12px}
 .chapter-nav{position:sticky;top:var(--case-nav-top,80px);z-index:40;background:#f5f4edf5;backdrop-filter:blur(16px);border-bottom:1px solid #d5d8ce}.chapter-nav .case-shell{display:flex;justify-content:space-between;gap:24px;overflow-x:auto;scrollbar-width:none}.chapter-nav .case-shell::-webkit-scrollbar{display:none}.chapter-nav a{display:flex;align-items:center;gap:10px;white-space:nowrap;padding:21px 0;font-size:13px;color:#555f56;position:relative}.chapter-nav a>span{font:9px 'JetBrains Mono Variable',monospace;color:#7e8b7d}.chapter-nav a[aria-current]{color:#181d19;font-weight:650}.chapter-nav a[aria-current]:after{content:'';height:3px;background:#e11d48;position:absolute;bottom:0;left:0;right:0}.reading-track{height:2px;background:#e5e8dc}.reading-track>span{display:block;height:100%;width:0;background:#e11d48}
 .story-body{padding-top:16px}.story-section{padding-block:80px;scroll-margin-top:170px;border-bottom:1px solid #d6dacf}.section-index{font:10px 'JetBrains Mono Variable',monospace;text-transform:uppercase;letter-spacing:.12em;color:#596953;margin-bottom:24px}.story-section h2,.case-closing h2,.other-cases h2{font-size:clamp(32px,4vw,48px);font-weight:500;letter-spacing:-.035em;line-height:1.12;margin-bottom:24px}.challenge-section{display:grid;grid-template-columns:1fr 1fr;gap:72px}.challenge-copy{padding-top:42px}.challenge-copy>p{font-size:19px;line-height:1.75;color:#4e5a4e}.challenge-turn{display:flex;gap:16px;border-left:2px solid #e11d48;padding:8px 0 8px 24px;margin-top:32px}.challenge-turn>span{color:#e11d48;font-size:28px}.challenge-turn p{font-size:16px;line-height:1.6}.section-intro{max-width:740px;margin-bottom:36px}.section-intro>p:last-child:not(.section-index){color:#5c675b;font-size:18px;line-height:1.7}
 .feature-note{display:flex;gap:22px;margin-top:28px;padding:28px;background:#ecefe2;border-radius:12px}.feature-note>span{color:#e11d48;font-size:30px}.feature-note h3{font-size:22px;font-weight:550;margin-bottom:12px}.feature-note p{color:#52604d;line-height:1.7}.feature-note a{display:inline-block;margin-top:18px;text-decoration:underline;text-underline-offset:5px;min-height:30px}
 .decision-list{border-top:1px solid #bdc6b7}.decision-list details{border-bottom:1px solid #bdc6b7}.decision-list summary{display:flex;gap:24px;align-items:center;cursor:pointer;padding:28px 8px;list-style:none}.decision-list summary::-webkit-details-marker{display:none}.decision-number{font:11px 'JetBrains Mono Variable',monospace;color:#e11d48}.decision-list h3{flex:1;font-size:clamp(20px,2.5vw,28px);font-weight:500;line-height:1.3}.decision-toggle{font-size:28px;font-weight:300}.decision-list details[open] .decision-toggle{transform:rotate(45deg)}.decision-content{padding:0 48px 30px 48px;max-width:850px}.decision-content p{font-size:18px;color:#52604d;line-height:1.8}
 .evidence-grid{display:grid;grid-template-columns:1.15fr 1fr;border:1px solid #d0d6c7;border-radius:14px;overflow:hidden;background:#fff}.evidence-result{padding:38px}.evidence-label{font:10px 'JetBrains Mono Variable',monospace;text-transform:uppercase;color:#617455}.evidence-number{font-size:clamp(32px,5vw,58px);line-height:1.1;letter-spacing:-.035em;margin:22px 0;font-weight:550}.evidence-result>p:last-of-type{font-size:18px;line-height:1.8;color:#52604d}.evidence-result a{display:inline-block;text-decoration:underline;text-underline-offset:5px;margin-top:24px;min-height:32px}.evidence-scope{background:#e9edde;padding:38px;border-left:1px solid #d0d6c7}.evidence-scope h3{font-size:20px;font-weight:600;margin-bottom:18px}.evidence-scope p{font-size:14px;line-height:1.9;color:#52604d}.takeaway{padding:40px 0 0;max-width:850px}.takeaway>p{font-size:clamp(23px,3vw,32px);line-height:1.5;letter-spacing:-.015em}
 .case-closing{padding:80px 0;text-align:center}.case-closing>.case-kicker{justify-content:center;color:#617455;margin-bottom:24px}.case-closing>p{font-size:18px;color:#52604d}.service-link{display:block;margin-top:24px;text-decoration:underline;text-underline-offset:5px;font-size:14px}.case-author{font-size:12px;color:#617455;margin-top:40px}.case-author a{text-decoration:underline}.other-cases{padding:50px 0 60px;border-top:1px solid #cbd3c2}.other-case-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:32px 0}.other-case-grid>a{display:block;position:relative;padding:26px;background:#e9edde;border:1px solid #d5dccd;border-radius:10px;transition:background .2s}.other-case-grid>a:hover{background:#dce9c7}.other-case-grid>a>span:first-child{font:9px 'JetBrains Mono Variable',monospace;text-transform:uppercase;color:#617455;line-height:1.6}.other-case-grid h3{font-size:22px;font-weight:550;margin:22px 0 14px;line-height:1.3}.other-case-grid p{font-size:18px}.other-arrow{position:absolute;right:22px;bottom:25px;color:#e11d48}.all-cases-link{font-size:14px;text-decoration:underline;text-underline-offset:5px}
 a:focus-visible,summary:focus-visible{outline:3px solid #e11d48;outline-offset:5px}
 @media(max-width:1000px){.hero-columns{gap:32px}.challenge-section{gap:36px}.chapter-nav{top:var(--case-nav-top,92px)}.hero-number{font-size:32px}.hero-diagram{padding:25px 18px}}
 @media(max-width:760px){.case-hero{padding-top:24px}.case-breadcrumb{margin-bottom:38px}.hero-columns{grid-template-columns:1fr;gap:36px}h1{font-size:clamp(42px,10vw,68px)}.hero-deck{font-size:19px}.hero-art{max-width:520px;width:100%;margin:auto}.case-stats{margin-top:26px}.case-stats>div{padding:22px 10px 22px 0}.case-stats>div+div{padding-left:16px}.case-stats strong{font-size:26px}.case-stats span{font-size:9px}.chapter-nav .case-shell{gap:26px}.chapter-nav a{font-size:12px;padding:18px 0}.chapter-nav{top:var(--case-nav-top,92px)}.story-section{padding-block:52px;scroll-margin-top:155px}.challenge-section{grid-template-columns:1fr;gap:0}.challenge-copy{padding-top:0}.evidence-grid{grid-template-columns:1fr}.evidence-scope{border-left:none;border-top:1px solid #d0d6c7}.evidence-result,.evidence-scope{padding:28px}.other-case-grid{grid-template-columns:1fr}.other-case-grid h3{margin:16px 0}.feature-note{padding:22px;gap:14px}.decision-list summary{gap:16px}.decision-content{padding-left:34px;padding-right:12px}.case-closing{padding:60px 0}.hero-number{font-size:40px}}

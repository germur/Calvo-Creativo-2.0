---
import CookieConsent from '@/src/components/CookieConsent.astro';
import { siteGraph } from '@/lib/person-schema';
import '@/styles/globals.css';
import '@fontsource/anton/latin-400.css';
import '@fontsource/bangers/latin-400.css';
import '@fontsource-variable/outfit/index.css';
import '@fontsource-variable/jetbrains-mono/index.css';
import '@fontsource-variable/newsreader/index.css';
import '@fontsource-variable/newsreader/standard-italic.css';


---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9760938521576702" crossorigin="anonymous"></script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
  <slot name="head" />
  <script type="application/ld+json" set:html={JSON.stringify(siteGraph).replaceAll('<', '\\u003c')} />
</head>
<body class="bg-paper text-ink font-body grain-overlay">
  <slot />
  <CookieConsent />
  <script>import '@/src/site/browser';</script>
</body>
</html>
<style is:global>
  :root { --font-newsreader: 'Newsreader Variable'; }
  .font-body, .font-sans { font-family: 'Outfit Variable', sans-serif; }
  .font-mono { font-family: 'JetBrains Mono Variable', monospace; }
  /* Small white-belt trims: decorative, with four stripes and stitched edges. */
  [data-bjj-corner] { position: relative; }
  [data-bjj-corner]::after { content: ''; position: absolute; z-index: 3; right: -22px; top: 22px; width: 122px; height: 21px; transform: rotate(45deg); pointer-events: none; background: linear-gradient(to right, #f8f4e9 0 56%, #28221b 56% 61%, #f8f4e9 61% 65%, #28221b 65% 70%, #f8f4e9 70% 74%, #28221b 74% 79%, #f8f4e9 79% 83%, #28221b 83% 88%, #f8f4e9 88% 92%, #28221b 92% 100%); border: 1px solid #a89c82; box-shadow: 0 3px 2px #28221b25; outline: 1px dashed #a89c82; outline-offset: -4px; }
  .portfolio-card:nth-child(even) [data-bjj-corner]::after { right:auto; left:-22px; transform:rotate(-45deg); }
  .hero-art[data-bjj-corner] { overflow:hidden; }
  .card-cover[data-bjj-corner] { overflow:hidden; }
  .card-read::before { content:''; width:24px; height:12px; margin-right:10px; background:repeating-linear-gradient(90deg,#194e56 0 4px,transparent 4px 7px); align-self:center; }
  .card-read { justify-content:flex-start!important; }
  .card-read>span { margin-left:auto; }
  .bjj-knot { position:relative; display:inline-block; width:30px; height:40px; flex-shrink:0; }
  .bjj-knot::before,.bjj-knot::after { content:''; position:absolute; top:14px; width:9px; height:25px; background:#f0e7d3; border:1px solid #b5a380; transform-origin:top; }
  .bjj-knot::before { left:9px; transform:rotate(22deg); }
  .bjj-knot::after { right:9px; transform:rotate(-22deg); }
  .bjj-knot i { position:absolute; top:8px; left:5px; right:5px; height:11px; z-index:1; background:#e9dec3; border:1px solid #b5a380; transform:rotate(-12deg); }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; }
  }
</style>


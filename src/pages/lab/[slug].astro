---
import * as view from '@/src/views/lab/[slug].tsx';
import Page from '@/src/layouts/Page.astro';
export async function getStaticPaths() {
  const { paths } = await view.getStaticPaths();
  return paths.map(({ params }) => ({ params, props: {} }));
}
const props = Astro.props;
---
<Page component={view.default} pageProps={props} />

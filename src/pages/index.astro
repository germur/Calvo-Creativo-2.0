---
import Document from '@/src/layouts/Document.astro';
import Navigation from '@/src/components/Navigation.astro';
import Footer from '@/src/components/Footer.astro';
import CaseCards from '@/src/components/CaseCards.astro';
import HomeArtwork from '@/src/components/HomeArtwork.astro';

---
<Document>
<Fragment slot="head">
                <title>Consultor SEO estratégico | Roger Murillo · Calvo Creativo</title>
                <meta name="description" content="Consultoría SEO con Roger Murillo para empresas de USA y Latam. Estrategia, arquitectura web, contenido y automatización, con casos y alcance de trabajo claro." />
                <link rel="canonical" href="https://calvocreativo.com" />
                {/* Open Graph + Twitter (tanda 6) */}
                <meta property="og:type" content="website" />
                <meta property="og:url" content="https://calvocreativo.com" />
                <meta property="og:title" content="Consultor SEO estratégico | Roger Murillo · Calvo Creativo" />
                <meta property="og:description" content="Estrategia SEO, arquitectura web, contenido y automatización para empresas de USA y Latam. Explora el trabajo y hablemos de tu proyecto." />
                <meta property="og:image" content="https://calvocreativo.com/api/og?title=Consultor%20SEO%20%26%20GEO%20%7C%20B2B%20USA-Latam" />
                <meta property="og:site_name" content="Calvo Creativo" />
                <meta name="twitter:card" content="summary_large_image" />
                <meta name="twitter:site" content="@Rogermu47429637" />
                <meta name="twitter:image" content="https://calvocreativo.com/api/og?title=Consultor%20SEO%20%26%20GEO%20%7C%20B2B%20USA-Latam" />

                {/* Schema: WebPage */}
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify({
                            "@context": "https://schema.org",
                            "@type": "WebPage",
                            "@id": "https://calvocreativo.com/#webpage",
                            "url": "https://calvocreativo.com",
                            "name": "Consultor SEO estratégico | Roger Murillo · Calvo Creativo",
                            "description": "Consultoría SEO con Roger Murillo: estrategia, arquitectura web, contenido y automatización para empresas de USA y Latam.",
                            "isPartOf": {
                                "@id": "https://calvocreativo.com/#website"
                            },
                            "about": {
                                "@id": "https://calvocreativo.com/#organization"
                            },
                            "primaryImageOfPage": {
                                "@type": "ImageObject",
                                "url": "https://calvocreativo.com/api/og?title=Calvo%20Creativo"
                            }
                        })
}
                />
            </Fragment>
        <div class="min-h-screen flex flex-col bg-paper font-sans selection:bg-red-600 selection:text-white">


            <Navigation />
            <main id="contenido">

            <HomeArtwork />

            <section aria-labelledby="problema-titulo" class="py-20 px-6 md:px-12 bg-paper text-ink border-b border-black/15">
                <div class="max-w-7xl mx-auto">
                    <p class="font-mono text-xs uppercase tracking-widest text-primary mb-4">Tu punto de partida</p>
                    <h2 id="problema-titulo" class="font-display text-4xl md:text-5xl uppercase mb-6">¿Qué necesita resolver tu negocio?</h2>
                    <p class="text-lg text-ink/80 max-w-2xl mb-10">El problema define el trabajo. Empecemos por lo que hoy está frenando tu siguiente paso.</p>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        {[
                            {title: 'Tengo visitas, pero pocos contactos', text: 'Revisar qué buscan tus compradores, cómo presentas la oferta y qué recorrido les permite consultar o contratar.', href: '/consultoria/estrategia-contenidos-autoridad', link: 'Ver estrategia de contenidos'},
                            {title: 'Mi web necesita una base más sólida', text: 'Diagnosticar rastreo, arquitectura y problemas técnicos. Priorizar las correcciones y planificar una migración si el proyecto la necesita.', href: '/consultoria/arquitectura-seo-geo', link: 'Ver arquitectura y SEO técnico'},
                            {title: 'Mi equipo repite tareas cada semana', text: 'Identificar qué reportes y procesos se pueden automatizar, con fuentes de datos, mantenimiento y revisión definidos.', href: '/consultoria/automatizacion-seo-ia', link: 'Ver automatización SEO'},
                        ].map(item => (
                            <article class="border border-black/20 bg-white p-7 flex flex-col">
                                <h3 class="font-display text-2xl uppercase mb-4">{item.title}</h3>
                                <p class="text-ink/75 leading-relaxed mb-6">{item.text}</p>
                                <a href={item.href} class="mt-auto font-semibold underline underline-offset-4 decoration-primary py-2">{item.link} →</a>
                            </article>
                        ))}
                    </div>
                </div>
            </section>

            {/* --- 3. EL SELECTOR DE CAMINO (THE ROUTER) --- */}
            <section class="py-24 px-6 md:px-12 bg-white text-black border-b-4 border-black">
                <div class="max-w-7xl mx-auto">
                    <div class="text-center mb-16">
                        <h2 class="text-4xl md:text-6xl font-display font-black uppercase text-black">Elige tu Camino</h2>
                        <p class="font-mono text-sm tracking-widest text-gray-500 uppercase mt-2">¿Negocio o Investigación?</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                        {/* LADO A */}
                        <div class="group border-4 border-black p-8 hover:bg-gray-50 transition-all shadow-brutal hover:shadow-none hover:translate-x-2 hover:translate-y-2 relative overflow-hidden">
                            <div class="absolute top-0 right-0 bg-black text-white px-4 py-1 font-mono text-xs font-bold uppercase">Lado A</div>
                            <div class="mb-6">
                                <span class="text-6xl">💿</span>
                            </div>
                            <h3 class="text-3xl font-display font-bold uppercase mb-4">Consultoría & Servicios</h3>
                            <p class="text-gray-700 font-medium mb-6">
                                Para empresas que necesitan una dirección SEO clara, apoyo técnico o una estrategia de contenidos conectada con su oferta.
                            </p>
                            <ul class="mb-8 space-y-2 font-mono text-sm text-gray-600">
                                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-red-600 rounded-full"></span>Arquitectura GEO & SEO Técnico</li>
                                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-red-600 rounded-full"></span>Estrategia de Autoridad Temática</li>
                                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-red-600 rounded-full"></span>Expansión Internacional (Cross-Border)</li>
                            </ul>
                            <a
                                href="/consultoria"
                                data-event="click_view_services" data-category="Navigation" data-label="Lado A Selection"
                                class="inline-block w-full text-center bg-black text-white font-bold uppercase py-3 hover:bg-red-600 transition-colors"
                            >
                                Ir a Servicios →
                            </a>
                        </div>

                        {/* LADO B */}
                        <div class="group border-4 border-black p-8 bg-[#120810] text-white transition-all shadow-brutal hover:shadow-none hover:translate-x-2 hover:translate-y-2 relative overflow-hidden">
                            <div class="absolute top-0 right-0 bg-acid-green text-black px-4 py-1 font-mono text-xs font-bold uppercase">Lado B</div>
                            <div class="mb-6">
                                <span class="text-6xl">🎺</span>
                            </div>
                            <h3 class="text-3xl font-display font-bold uppercase mb-4 text-acid-green">The Lab</h3>
                            <p class="text-gray-300 font-medium mb-6">
                                <strong>Para los que rompen cosas.</strong> Si abres la consola del navegador antes de leer el contenido, este es tu sitio.
                            </p>
                            <ul class="mb-8 space-y-2 font-mono text-sm text-gray-400">
                                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-acid-green rounded-full"></span>SEO Fight Club (Experimentos)</li>
                                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-acid-green rounded-full"></span>Vibe Coding (Automations)</li>
                                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-acid-green rounded-full"></span>Liner Notes (Ensayos)</li>
                            </ul>
                            <a
                                href="/lab"
                                data-event="click_enter_lab" data-category="Navigation" data-label="Lado B Selection"
                                class="inline-block w-full text-center bg-white text-black font-bold uppercase py-3 hover:bg-acid-green hover:border-acid-green transition-colors"
                            >
                                Entrar al Lab →
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <section aria-labelledby="visibilidad-titulo" class="py-20 md:py-28 px-6 md:px-12 bg-paper text-ink border-b border-black/15">
                <div class="max-w-6xl mx-auto">
                    <p class="font-mono text-xs uppercase tracking-widest text-primary mb-6">SEO y respuestas de IA</p>
                    <h2 id="visibilidad-titulo" class="font-editorial text-4xl md:text-6xl leading-tight max-w-3xl mb-8">Que encuentren tu negocio.<br /><em>Que entiendan por qué elegirte.</em></h2>
                    <p class="text-lg leading-relaxed text-ink/75 max-w-3xl mb-12">Un comprador puede conocer tu marca en Google, en una respuesta de IA o por una recomendación. Trabajamos la claridad de tu oferta, el contenido que resuelve sus dudas y la evidencia de lo que haces.</p>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        {[
                            {number: '01', title: 'Una web accesible y clara', text: 'Revisar rastreo, indexación, arquitectura y enlaces para que las páginas importantes puedan encontrarse y leerse.'},
                            {number: '02', title: 'Respuestas con evidencia', text: 'Explicar servicios, alternativas y decisiones del comprador con casos, ejemplos y fuentes que respalden cada afirmación.'},
                            {number: '03', title: 'Medir presencia y negocio', text: 'Observar menciones y citas en un conjunto definido de preguntas. Revisar también consultas, contactos y oportunidades comerciales.'},
                        ].map(item => (
                            <article class="border-t border-black/20 pt-6">
                                <p class="font-mono text-sm text-primary mb-4">{item.number}</p>
                                <h3 class="font-editorial text-2xl font-semibold mb-4">{item.title}</h3>
                                <p class="leading-relaxed text-ink/75">{item.text}</p>
                            </article>
                        ))}
                    </div>
                    <p class="mt-10 text-sm text-ink/70 max-w-3xl">Una cita usa tu contenido como fuente; una mención nombra tu marca y puede ser una recomendación o una referencia neutral. El monitoreo permite observar esas diferencias. Ninguna implementación garantiza que un modelo te recomiende.</p>
                    <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4">
                        <a href="/consultoria/arquitectura-seo-geo" class="font-semibold underline underline-offset-4 decoration-primary">Explorar arquitectura SEO y GEO →</a>
                        <a href="/consultoria#como-trabajamos" class="font-semibold underline underline-offset-4 decoration-primary">Cómo trabajamos y qué medimos →</a>
                    </div>
                </div>
            </section>

            {/* --- 5. FEATURED INSIGHT --- */}
            <section class="py-16 px-6 md:px-12 bg-[#E11D48] text-white">
                <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center gap-8 border-4 border-black bg-white text-black p-8 shadow-[8px_8px_0px_#000]">
                    <div class="flex-1">
                        <p class="font-mono text-xs font-bold uppercase tracking-widest text-[#E11D48] mb-2">Una decisión puesta en práctica</p>
                        <h2 class="font-display text-2xl font-bold uppercase mb-2">De una web problemática a un recorrido de consulta</h2>
                        <p class="text-gray-700 text-sm">
                            En el proyecto de asesoría de imagen, reconstruimos la web y ordenamos servicios, programas y contenidos. El caso explica las decisiones, las solicitudes registradas y los límites de la medición.
                        </p>
                    </div>
                    <a href="/casos/rogermurillo" class="shrink-0 bg-black text-white px-6 py-3 font-bold uppercase hover:bg-gray-800 transition-colors">
                        Explorar el caso →
                    </a>
                </div>
            </section>

            {/* --- 5.5. FEATURED IN --- */}
            <section class="py-12 bg-gray-50 border-b-4 border-black">
                <div class="max-w-7xl mx-auto px-6 text-center">
                    <p class="font-mono text-xs font-bold uppercase tracking-widest text-gray-500 mb-6">Participación en publicaciones de SEO</p>
                    <div class="flex justify-center items-center gap-8 grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all">
                        <a href="https://backlinkbuilding.io/qa/25-ways-seo-tools-changed-our-keyword-research-approach/" target="_blank" class="group flex flex-col items-center gap-2">
                            <div class="font-display text-2xl font-black uppercase tracking-tighter text-black group-hover:text-blue-600 transition-colors">
                                BacklinkBuilding<span class="text-gray-400">.io</span>
                            </div>
                            <span class="text-[10px] font-mono bg-black text-white px-2 py-0.5 rounded-sm group-hover:bg-blue-600 transition-colors">Expert Interview Feature</span>
                        </a>
                    </div>
                </div>
            </section>

            <section class="max-w-7xl mx-auto px-6 py-16">
                <p class="font-mono text-primary uppercase text-sm mb-4">De la estrategia al trabajo real</p>
                <h2 class="font-display text-4xl md:text-5xl mb-6">Trabajos y casos de éxito</h2>
                <p class="text-lg text-gray-700 max-w-2xl mb-8">SEO, desarrollo y Ads: así abordamos proyectos de fisioterapia, asesoría de imagen, reclamaciones y captación de contactos.</p>
                <CaseCards />
                <a href="/casos" class="inline-block mt-8 font-bold underline decoration-primary underline-offset-4">Explorar todos los casos →</a>
            </section>
            {/* --- 6. SOCIAL PROOF & FOOTER --- */}
            <section class="py-20 bg-black text-white text-center">
                <div class="max-w-7xl mx-auto px-6">
                    <h2 class="text-3xl md:text-4xl font-display uppercase mb-12">
                        Construyamos tu activo digital.<br />
                        <span class="text-gray-500 text-xl md:text-2xl lowercase font-sans font-light">No alquiles tu audiencia. Sé dueño de tu tráfico.</span>
                    </h2>

                    <div class="flex flex-wrap justify-center items-center gap-4 md:gap-5 mb-16">
                        {[
                            { name: 'Python', icon: 'code' },
                            { name: 'Claude AI', icon: 'smart_toy' },
                            { name: 'Screaming Frog', icon: 'bug_report' },
                            { name: 'Semrush', icon: 'query_stats' },
                            { name: 'Ahrefs', icon: 'leaderboard' },
                            { name: 'Google Search Console', icon: 'monitoring' },
                        ].map((tool) => (
                            <div class="flex items-center gap-2 border border-white/20 rounded-full px-4 py-2 bg-white/5 hover:bg-white/10 transition-colors">
                                <span class="material-symbols-outlined text-sm text-gray-400">{tool.icon}</span>
                                <span class="font-mono text-xs uppercase tracking-wide text-gray-300">{tool.name}</span>
                            </div>
                        ))}
                    </div>

                    <div class="flex flex-col items-center">
                        <a
                            href="/contacto"
                            data-event="click_schedule_audit" data-category="Conversion" data-label="Footer CTA"
                            class="inline-block bg-white text-black font-display text-xl uppercase px-12 py-5 rounded-full hover:scale-105 transition-transform shadow-[0_0_20px_rgba(255,255,255,0.3)]"
                        >
                            Hablemos de tu proyecto →
                        </a>
                        <p class="mt-6 text-gray-400 font-mono text-sm tracking-wide">
                            Cuéntame tu objetivo, tu web y qué necesitas resolver para definir el siguiente paso.
                        </p>
                    </div>
                </div>
            </section>

            </main>
            <Footer />
        </div>
</Document>

---
import { caseEvidence } from '@/src/case-evidence';
type View = (typeof caseEvidence)[keyof typeof caseEvidence]['views'][number];
const { slug } = Astro.props as {slug:keyof typeof caseEvidence};
const evidence = caseEvidence[slug];
---
<div class="work-gallery" data-work-gallery>
  <div class="gallery-intro"><p class="gallery-kicker">El trabajo real</p><h3>{evidence.title}</h3><p>{evidence.intro}</p></div>
  {evidence.views.length > 1 && <div class="gallery-controls" data-gallery-controls hidden role="group" aria-label="Vistas del proyecto">{evidence.views.map((view:View,index:number)=><button type="button" data-gallery-choice={index} aria-controls={`${slug}-view-${index}`} aria-pressed={index===0}>{view.label}</button>)}</div>}
  <noscript><p class="gallery-note">Puedes ver todas las capturas a continuación.</p></noscript>
  {evidence.views.map((view:View,index:number)=><div class="gallery-view" data-gallery-panel={index} id={`${slug}-view-${index}`}>
    <figure><div class="capture-frame"><a href={view.image} target="_blank" rel="noopener noreferrer" aria-label={`Ampliar captura: ${view.label}`}><img src={view.image} alt={view.alt} width={view.width} height={view.height} loading="lazy"/></a></div><figcaption><span>{view.caption}</span><a href={view.image} target="_blank" rel="noopener noreferrer">Ampliar ↗</a></figcaption></figure>
    <div class="capture-story"><span class="capture-index" aria-hidden="true">0{index+1}</span><div><h4>{view.title}</h4><p>{view.text}</p>{view.source && <a href={view.source} target="_blank" rel="noopener noreferrer">{view.sourceLabel} ↗</a>}</div></div>
  </div>)}
  {evidence.note && <p class="gallery-note">{evidence.note}</p>}
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-work-gallery]').forEach(gallery=>{
 const controls=gallery.querySelector<HTMLElement>('[data-gallery-controls]');
 if(!controls)return;
 const buttons=Array.from(controls.querySelectorAll<HTMLButtonElement>('[data-gallery-choice]'));
 const panels=Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-panel]'));
 const choose=(index:string)=>{buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.galleryChoice===index)));panels.forEach(panel=>{panel.hidden=panel.dataset.galleryPanel!==index;});};
 buttons.forEach(button=>button.addEventListener('click',()=>choose(button.dataset.galleryChoice||'0')));
 controls.hidden=false;choose('0');
});
</script>
<style>
.work-gallery{margin-bottom:44px;border:1px solid #b9a986;background:#f8f1e2;padding:clamp(16px,3vw,32px)}.gallery-intro{max-width:760px;margin-bottom:24px}.gallery-kicker{font:10px 'JetBrains Mono Variable',monospace;text-transform:uppercase;color:#8d3629;letter-spacing:.1em;margin-bottom:12px}.gallery-intro h3{font:clamp(25px,3vw,35px)/1.15 'Anton',sans-serif;text-transform:uppercase;margin:0 0 16px}.gallery-intro>p:last-child,.capture-story p{font-size:17px;line-height:1.7;color:#62543f}.gallery-controls{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px}.gallery-controls[hidden],[data-gallery-panel][hidden]{display:none}.gallery-controls button{min-height:44px;padding:10px 18px;border:1px solid #8f7a57;color:#28221b;background:transparent;cursor:pointer;font-size:14px}.gallery-controls button[aria-pressed=true]{background:#28221b;color:#f1e5c9;border-color:#28221b;box-shadow:3px 3px 0 #b53728}.capture-frame{background:#e7d9b9;border:1px solid #c8b994;aspect-ratio:1280/900;display:flex;align-items:center}.capture-frame a{display:block;width:100%}.capture-frame img{display:block;width:100%;height:auto;max-height:100%;object-fit:contain}.gallery-view figure{margin:0}.gallery-view figcaption{display:flex;justify-content:space-between;gap:16px;font:10px/1.7 'JetBrains Mono Variable',monospace;padding:12px 0;color:#665842}.gallery-view figcaption a{white-space:nowrap;text-decoration:underline;text-underline-offset:4px;min-height:32px;display:flex;align-items:center}.capture-story{display:flex;gap:20px;border-top:1px solid #c8b994;padding:24px 0 0}.capture-index{font:36px/1 'Anton',sans-serif;color:#b53728}.capture-story h4{font-size:22px;line-height:1.3;margin-bottom:12px;font-weight:600}.capture-story a{display:inline-block;margin-top:12px;text-decoration:underline;text-underline-offset:4px;min-height:44px;color:#8d3629}.gallery-note{font-size:12px;line-height:1.7;color:#665842;margin:24px 0 0}a:focus-visible,button:focus-visible{outline:3px solid #b53728;outline-offset:5px}@media(max-width:650px){.capture-story{gap:12px}.capture-index{font-size:26px}.capture-story h4{font-size:20px}.gallery-view figcaption{font-size:9px}.gallery-controls button{padding:10px 12px}.capture-frame{aspect-ratio:auto}}
</style>

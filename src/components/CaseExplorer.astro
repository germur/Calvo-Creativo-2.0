---
import results from '@/src/contact-results.json';
const { slug } = Astro.props;
const searchPaths = [
  { label: 'Codo', query: '«me duele el codo por dentro»', zone: 'Codo', page: '/lesiones/epitrocleitis', topic: 'Contenido sobre epitrocleítis', reason: 'La entrada es la zona que reconoce la persona. El contenido explica un tema relacionado; el síntoma por sí solo no confirma esa lesión.' },
  { label: 'Rodilla', query: '«me duele la rodilla por dentro»', zone: 'Rodilla', page: '/lesiones/tendinitis', topic: 'Contenido sobre tendinitis rotuliana', reason: 'La zona acerca al usuario a información que puede explorar. Esta página es un ejemplo de contenido de la arquitectura, no una equivalencia entre la consulta y un diagnóstico.' },
  { label: 'Hombro', query: '«me duele el hombro al moverlo»', zone: 'Hombro', page: '/lesiones/hombro', topic: 'Contenido sobre hombro', reason: 'La persona puede comenzar por el hombro sin conocer un nombre técnico. La página ofrece información y una opción de valoración profesional.' },
];
const crmSteps = [
  { label: '01 · Centralizar', title: 'De archivos a expedientes', text: 'El punto de partida eran hojas de Excel y carpetas en OneDrive. El CRM reúne la reclamación, sus documentos y su seguimiento en un recorrido que utiliza el equipo.', outcome: 'Un sistema compartido para la operación.' },
  { label: '02 · Priorizar', title: 'Saber qué caso necesita atención', text: 'Filtros, paneles por estado, actividades y seguimientos ayudan a consultar el contexto y los siguientes pasos de cada reclamación.', outcome: 'El archivo se convierte en trabajo que se puede seguir.' },
  { label: '03 · Automatizar', title: 'La agenda llega al correo', text: 'La integración de Outlook conecta citas y seguimientos con un resumen diario de lunes a viernes. El piloto está configurado para un usuario a las 8:00 a. m., hora de Miami.', outcome: 'La agenda y los pendientes se incorporan al día de trabajo.' },
  { label: '04 · Contratos', title: 'Revisar el intake y el documento', text: 'El equipo completa datos por secciones y revisa el documento correspondiente al estado y sus firmantes. La versión documentada está en beta: no envía contratos reales para firma.', outcome: 'El contrato se integra al recorrido, con revisión antes de avanzar.' },
];
const campaigns = [
  { label: 'Carros', before: 17518, after: 7715, dailyBefore: '1,36', dailyAfter: '2,84', change: '−56%', lesson: 'Más acciones diarias a menor costo. Los términos de búsqueda también revelaron contactos con intención de comprar vehículos; se añadieron exclusiones.' },
  { label: 'Motos', before: 8864, after: 14207, dailyBefore: '2,36', dailyAfter: '1,56', change: '+60%', lesson: 'El cambio de puja rindió peor: menos acciones diarias y mayor costo. La separación permitió detectar esa diferencia y ajustar motos por su cuenta.' },
];
---
<div class="case-explorer" data-case-explorer>
  <noscript><p class="explorer-note">Aquí puedes leer todas las vistas del recorrido. Activa JavaScript para alternar entre ellas.</p></noscript>
  {slug === 'german-montenegro' && <>
    <div class="explorer-top"><span>De la investigación al recorrido</span><span>El síntoma es la entrada</span></div>
    <p class="explorer-instruction">Elige un ejemplo de búsqueda y recorre la experiencia que planteamos.</p>
    <div class="explorer-controls" data-explorer-controls hidden role="group" aria-label="Zona del recorrido">{searchPaths.map((path, index) => <button type="button" data-choice={index} aria-controls={`search-path-${index}`} aria-pressed={index === 0}>{path.label}</button>)}</div>
    {searchPaths.map((path, index) => <div data-explorer-panel={index} id={`search-path-${index}`}>
      <div class="search-query"><span aria-hidden="true">⌕</span><p>{path.query}</p></div>
      <div class="symptom-journey">
        <div><span>01 / Necesidad</span><h3>«Me duele aquí»</h3><p>La persona describe lo que siente, sin un término técnico.</p><small>Punto de partida</small></div>
        <div><span>02 / Zona</span><h3>{path.zone}</h3><p>Señala una zona en el cuerpo interactivo 3D.</p><small>Selector implementado</small></div>
        <div><span>03 / Contenido</span><h3>Explorar el tema</h3><p>{path.topic}. Una página para entender el contenido relacionado.</p><a href={`https://germanmontenegro.fit${path.page}`} target="_blank" rel="noopener noreferrer">Ver página real ↗</a><small>Transición desde el cuerpo en revisión</small></div>
        <div class="journey-planned"><span>04 / Explicación</span><h3>La voz de Germán</h3><p>Vídeo de YouTube del especialista para explicar el tema y su abordaje.</p><small>Previsto · No integrado en la página comprobada</small></div>
        <div><span>05 / Contacto</span><h3>Valoración personal</h3><p>Quien necesita atención puede contactar al profesional.</p><a href="https://germanmontenegro.fit/fisioterapia-deportiva-bogota" target="_blank" rel="noopener noreferrer">Ver opción de valoración ↗</a><small>Contacto disponible</small></div>
      </div>
      <div class="explorer-conclusion"><h3>Qué cambió al entender la intención</h3><p>{path.reason}</p><p>El cuerpo 3D responde al bache entre el lenguaje cotidiano y el contenido especializado. El vídeo y el contacto dan continuidad al recorrido diseñado.</p></div>
    </div>)}
    <p class="explorer-note">Ejemplos ilustrativos, sin volúmenes ni posiciones atribuidos. Este recorrido explica decisiones de SEO y experiencia; no identifica lesiones ni prescribe ejercicios. Revisión del 13 de octubre: selector y páginas disponibles; transición desde la tarjeta sin navegación verificada y vídeo pendiente en la página de codo.</p>
  </>}
  {slug === 'all-claims' && <>
    <div class="explorer-top"><span>Recorrido del CRM</span><span class="beta-label">Contrato en beta</span></div>
    <p class="explorer-instruction">Recorre las decisiones del flujo. Esta explicación no ejecuta acciones en el CRM.</p>
    <div class="explorer-controls" data-explorer-controls hidden role="group" aria-label="Etapa del CRM">{crmSteps.map((step,index) => <button type="button" data-choice={index} aria-controls={`crm-step-${index}`} aria-pressed={index === 0}>{step.label}</button>)}</div>
    {crmSteps.map((step,index) => <div class="crm-panel" data-explorer-panel={index} id={`crm-step-${index}`}><span class="step-watermark" aria-hidden="true">0{index+1}</span><div><p class="panel-kicker">La tarea del equipo</p><h3>{step.title}</h3><p>{step.text}</p><div class="workflow-output"><span aria-hidden="true">↳</span><p>{step.outcome}</p></div></div></div>)}
    <p class="explorer-note">Representación del proceso documentado. Los datos y documentos de clientes permanecen privados.</p>
  </>}
  {slug === 'prendaautos' && <>
    <div class="explorer-top"><span>Dos campañas, dos aprendizajes</span><span>COP por acción</span></div>
    <p class="explorer-instruction">Compara carros y motos. La separación nos permitió ver comportamientos distintos.</p>
    <div class="explorer-controls" data-explorer-controls hidden role="group" aria-label="Campaña">{campaigns.map((campaign,index) => <button type="button" data-choice={index} aria-controls={`campaign-${index}`} aria-pressed={index === 0}>{campaign.label}</button>)}</div>
    {campaigns.map((campaign,index) => <div data-explorer-panel={index} id={`campaign-${index}`}><div class="campaign-heading"><h3>{campaign.label}</h3><p class:list={['campaign-change', {'is-worse':index === 1}]}>{campaign.change}<span>costo por acción de contacto</span></p></div>
      <div class="comparison-bar"><div><span>1–14 septiembre</span><strong>COP {campaign.before.toLocaleString('es-CO')}</strong></div><span class="bar-track"><span style={`width:${campaign.before/17518*100}%`} class="bar-before"></span></span></div>
      <div class="comparison-bar"><div><span>15 septiembre–9 octubre</span><strong>COP {campaign.after.toLocaleString('es-CO')}</strong></div><span class="bar-track"><span style={`width:${campaign.after/17518*100}%`} class:list={["bar-after",{"bar-worse":index === 1}]}></span></span></div>
      <p class="daily-actions">Acciones por día <strong>{campaign.dailyBefore} → {campaign.dailyAfter}</strong></p><p class="explorer-learning">{campaign.lesson}</p>
    </div>)}
    <p class="explorer-note">Períodos de 2026. Misma escala para las barras. Acciones registradas, no personas únicas ni préstamos cerrados. Varios ajustes coincidieron; la comparación no aísla causalidad.</p>
  </>}
  {slug === 'rogermurillo' && <>
    <div class="explorer-top"><span>Del interés al formulario</span><span>37 solicitudes</span></div>
    <p class="explorer-instruction">Explora cuándo llegaron los envíos y qué intereses seleccionaron.</p>
    <div class="explorer-controls" data-explorer-controls hidden role="group" aria-label="Vista de solicitudes"><button type="button" data-choice="0" aria-controls="contacts-months" aria-pressed="true">Por mes</button><button type="button" data-choice="1" aria-controls="contacts-interests" aria-pressed="false">Por interés</button></div>
    <div data-explorer-panel="0" id="contacts-months"><h3>Solicitudes registradas por mes</h3><div class="contact-bars">{results.months.map(row => <div class="contact-column"><strong>{row.submissions}</strong><span class="column-track"><span style={`height:${row.submissions/16*100}%`}></span></span><p>{({'2026-07':'26–31 jul','2026-08':'Agosto','2026-09':'Septiembre','2026-10':'1–12 oct'} as Record<string,string>)[row.month]}</p></div>)}</div><p class="explorer-note">Julio y octubre son períodos parciales. La altura compara envíos, no una tasa de crecimiento.</p></div>
    <div data-explorer-panel="1" id="contacts-interests"><h3>Intereses declarados en el formulario</h3><div class="interest-bars">{results.goals.map(row => <div><p>{row.goal}<strong>{row.submissions}</strong></p><span class="bar-track"><span class="bar-after" style={`width:${row.submissions/15*100}%`}></span></span></div>)}</div><p class="explorer-note">Selección múltiple: las categorías se superponen. Cuatro envíos no seleccionaron objetivo.</p></div>
    <div class="workflow-output"><span aria-hidden="true">↳</span><p>23 envíos seleccionan al menos una opción de imagen, colorimetría, visagismo o transición personal.</p></div>
    <p class="explorer-note">Fuente: CSV de Netlify Forms. 26 julio–12 octubre de 2026, horario de Colombia. Dos envíos comparten nombre y teléfono. El archivo no confirma ventas ni canal de adquisición.</p>
  </>}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-case-explorer]').forEach(explorer => {
    const controls = explorer.querySelector<HTMLElement>('[data-explorer-controls]');
    const buttons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-choice]'));
    const panels = Array.from(explorer.querySelectorAll<HTMLElement>('[data-explorer-panel]'));
    const select = (index: string) => {
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.choice === index)));
      panels.forEach(panel => { panel.hidden = panel.dataset.explorerPanel !== index; });
    };
    buttons.forEach(button => button.addEventListener('click', () => select(button.dataset.choice || '0')));
    if (controls) controls.hidden = false;
    select('0');
  });
</script>
<style>
  .case-explorer{background:#28221b;color:#f5f4ed;border:1px solid #514b40;border-radius:2px;padding:clamp(22px,4vw,44px);box-shadow:0 28px 80px #00000012;overflow:hidden}
  .explorer-top{display:flex;justify-content:space-between;gap:16px;font:11px 'JetBrains Mono Variable',monospace;text-transform:uppercase;letter-spacing:.1em;color:#e5b847;border-bottom:1px solid #514b40;padding-bottom:20px}
  .beta-label{color:#ffc477}.explorer-instruction{font-size:19px;max-width:660px;line-height:1.6;margin:24px 0}
  .explorer-controls{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}.explorer-controls[hidden],[data-explorer-panel][hidden]{display:none}
  button{border:1px solid #505b51;background:transparent;color:#f5f4ed;padding:12px 18px;border-radius:30px;font-size:14px;min-height:44px;cursor:pointer;transition:background .2s,color .2s}
  button[aria-pressed=true]{background:#e5b847;border-color:#e5b847;color:#28221b}button:hover{border-color:#e5b847}button:focus-visible,a:focus-visible{outline:3px solid #ffbdcb;outline-offset:5px}
  .search-query{display:flex;gap:14px;align-items:center;border:1px solid #766346;border-radius:12px;padding:18px 20px;background:#372e23}.search-query>span{font-size:32px;color:#e5b847}.search-query p{font-size:clamp(22px,3vw,32px);margin:0;line-height:1.3}.query-context{color:#c8bcaa;line-height:1.6;margin:18px 0}
.symptom-journey{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin:30px 0}.symptom-journey>div{background:#3a3328;border:1px solid #6b5940;padding:20px 14px;display:flex;flex-direction:column;gap:14px;min-width:0}.symptom-journey span{font:10px 'JetBrains Mono Variable',monospace;color:#e5b847}.symptom-journey h3{font-size:20px;margin:0}.symptom-journey p{font-size:14px;line-height:1.6;color:#d1c3a8}.symptom-journey small{font-size:10px;line-height:1.6;color:#c8bcaa;margin-top:auto;padding-top:10px;border-top:1px solid #6b5940}.symptom-journey a{font-size:12px;color:#e5b847;text-decoration:underline;text-underline-offset:4px;min-height:44px;display:flex;align-items:center}.symptom-journey .journey-planned{border-style:dashed;background:#302920}@media(max-width:950px){.symptom-journey{grid-template-columns:1fr}.symptom-journey>div{padding:22px}.symptom-journey h3{font-size:24px}.symptom-journey p{font-size:16px}}
  .architecture-path{display:flex;align-items:center;gap:12px;margin:32px 0}.architecture-path>div{flex:1;min-width:0;background:#3a3328;border:1px solid #6b5940;border-radius:12px;padding:20px 14px;min-height:112px;display:flex;flex-direction:column;justify-content:center;gap:12px}.architecture-path span:not(.path-arrow){font:10px 'JetBrains Mono Variable',monospace;color:#c8bcaa;text-transform:uppercase}.architecture-path strong{font-size:16px;overflow-wrap:anywhere}.path-arrow{color:#e5b847;font-size:24px}
  .explorer-conclusion{padding-top:24px;border-top:1px solid #514b40}.case-explorer h3{font-size:24px;font-weight:600;margin:0 0 16px;line-height:1.3}.explorer-conclusion p,.crm-panel p,.explorer-learning{color:#d1c3a8;line-height:1.7;font-size:17px}.explorer-conclusion a{display:inline-block;color:#e5b847;margin-top:20px;min-height:44px;text-decoration:underline;text-underline-offset:5px}
  .explorer-note{font-size:12px;color:#c8bcaa;line-height:1.7;margin-top:24px}.crm-panel{display:flex;gap:32px;align-items:flex-start;margin-top:40px}.step-watermark{font:100px 'Anton',sans-serif;color:#786541;line-height:1}.panel-kicker{font:10px 'JetBrains Mono Variable',monospace!important;text-transform:uppercase;color:#e5b847!important;margin-bottom:18px}
  .workflow-output{display:flex;gap:14px;align-items:flex-start;background:#403725;padding:18px 22px;margin-top:24px;border-left:2px solid #e5b847}.workflow-output>span{color:#e5b847;font-size:24px}.workflow-output p{margin:0;line-height:1.6;color:#e1e8da}
  .campaign-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:30px}.campaign-change{font-size:46px;color:#e5b847;font-weight:600;line-height:1;margin:0}.campaign-change span{display:block;color:#c8bcaa;font-size:11px;font-weight:400;margin-top:10px;line-height:1.4}.campaign-change.is-worse{color:#ffbdcb}.comparison-bar{margin:24px 0}.comparison-bar>div{display:flex;justify-content:space-between;gap:20px;margin-bottom:12px;font-size:13px}.bar-track{height:12px;background:#493e2d;display:block;border-radius:6px;overflow:hidden}.bar-track>span{display:block;height:100%;border-radius:6px}.bar-before{background:#879887}.bar-after{background:#e5b847}.bar-after.bar-worse{background:#ffbdcb}.daily-actions{margin-top:30px;color:#c8bcaa}.daily-actions strong{color:#f5f4ed;margin-left:16px;font-size:24px}.explorer-learning{border-top:1px solid #514b40;padding-top:24px;margin-top:24px}
  .contact-bars{display:flex;align-items:flex-end;gap:clamp(12px,4vw,36px);padding:30px 0 0}.contact-column{flex:1;text-align:center;min-width:0}.contact-column>strong{font-size:28px;color:#e5b847}.column-track{height:160px;display:flex;align-items:flex-end;margin:14px 0}.column-track>span{background:#e5b847;width:100%;border-radius:6px 6px 0 0}.contact-column p{font-size:12px;color:#c8bcaa}.interest-bars>div{margin:20px 0}.interest-bars p{display:flex;justify-content:space-between;gap:12px;margin-bottom:8px}.interest-bars strong{color:#e5b847}
  @media(max-width:650px){.architecture-path{flex-direction:column;align-items:stretch}.architecture-path>div{min-height:80px}.path-arrow{text-align:center;transform:rotate(90deg)}.crm-panel{gap:16px}.step-watermark{font-size:60px}.comparison-bar>div{flex-direction:column;gap:4px}.campaign-change{font-size:36px}.contact-column p{min-height:32px}.explorer-top{font-size:9px}.explorer-instruction{font-size:17px}}
</style>

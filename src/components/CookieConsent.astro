<div id="cookie-consent" hidden class="fixed bottom-0 left-0 right-0 z-[9999] p-4 md:p-6">
  <section aria-label="Preferencias de cookies" class="mx-auto bg-[#120810] border border-[#f4258c] p-6 max-w-2xl shadow-[0_0_30px_rgba(244,37,140,0.2)]">
    <div class="flex flex-col md:flex-row gap-6 items-start md:items-center justify-between">
      <div>
        <h2 class="text-[#f4258c] font-black uppercase tracking-widest text-sm font-mono mb-3">Tus preferencias de cookies</h2>
        <p class="text-white/80 text-sm leading-relaxed">Con tu permiso, usamos Google Analytics y Microsoft Clarity para entender cómo se utiliza el sitio y mejorarlo.</p>
        <a href="/politica-privacidad" class="inline-block mt-3 text-xs text-white underline">Política de privacidad</a>
      </div>
      <div class="flex gap-3">
        <button data-consent="accepted" class="bg-[#f4258c] text-white px-5 py-3 font-bold text-xs uppercase">Aceptar</button>
        <button data-consent="rejected" class="px-5 py-3 text-white border border-white/40 text-xs uppercase">Rechazar</button>
      </div>
    </div>
  </section>
</div>

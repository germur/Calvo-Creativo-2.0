---
import { cases } from '@/src/cases';
const images:Record<string,string>={'rogermurillo':'/images/case-roger-web.jpg','german-montenegro':'/images/case-german-web.jpg'};
---
<div class="portfolio-grid">
{cases.map((item,index) => <a href={`/casos/${item.slug}`} class="portfolio-card">
 <div class="card-cover">
  {images[item.slug]?<img src={images[item.slug]} alt={`Vista real de la web de ${item.client}`} width="1272" height="920" loading="lazy"/>:<div class="cover-diagram" aria-hidden="true">{item.slug==='prendaautos'?<><span>Costo por acción · carros</span><div class="mini-bar before">COP 17.518</div><div class="mini-bar after">COP 7.715</div></>:<><span>Un recorrido para el equipo</span><div class="mini-flow"><span>Intake</span><span>Estado</span><span>Revisión</span></div><p>Contrato en beta</p></>}</div>}
  <span class="card-id" aria-hidden="true">0{index+1}</span><span class="cover-arrow" aria-hidden="true">↗</span>
 </div>
 <div class="card-content"><p class="card-category">{item.category}</p><h3>{item.client}</h3><p class="card-summary">{item.summary}</p><div class="card-outcome"><strong>{item.signal}</strong><span>{item.label}</span></div><span class="card-read">Explorar el caso <span aria-hidden="true">→</span></span></div>
</a>)}
</div>
<style>
 .portfolio-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;font-family:'Outfit Variable',sans-serif}.portfolio-card{display:block;border:1px solid #d5dccd;border-radius:14px;background:#fafbf6;overflow:hidden;transition:box-shadow .25s,transform .25s}.portfolio-card:hover{transform:translateY(-5px);box-shadow:0 20px 50px #16291013}.portfolio-card:focus-visible{outline:3px solid #e11d48;outline-offset:5px}.card-cover{position:relative;aspect-ratio:2.15;background:#111512;overflow:hidden}.card-cover img{width:100%;height:100%;object-fit:cover;object-position:top;transition:transform .4s}.portfolio-card:hover .card-cover img{transform:scale(1.035)}.card-id{position:absolute;left:16px;top:16px;background:#111512d9;color:#c7fa72;border:1px solid #536251;padding:7px 10px;border-radius:5px;font:10px 'JetBrains Mono Variable',monospace}.cover-arrow{position:absolute;right:16px;bottom:16px;width:38px;height:38px;border-radius:50%;background:#c7fa72;display:grid;place-items:center;color:#111512;font-size:22px}.card-content{padding:28px}.card-category{font:9px 'JetBrains Mono Variable',monospace;text-transform:uppercase;letter-spacing:.07em;color:#617455;line-height:1.8}.card-content h3{font-size:28px;line-height:1.2;letter-spacing:-.02em;font-weight:550;margin:16px 0}.card-summary{font-size:16px;line-height:1.7;color:#52604d}.card-outcome{margin-top:24px;padding-top:20px;border-top:1px solid #d5dccd;display:flex;align-items:center;gap:20px}.card-outcome strong{font-size:26px;line-height:1.1;font-weight:600;white-space:nowrap;letter-spacing:-.025em}.card-outcome>span{font-size:11px;line-height:1.6;color:#617455}.card-read{display:flex;justify-content:space-between;font-size:13px;font-weight:600;margin-top:26px}.card-read>span{color:#e11d48}.cover-diagram{padding:34px 40px 26px 64px;color:#f5f4ed}.cover-diagram>span{font:10px 'JetBrains Mono Variable',monospace;color:#c7fa72;display:block;margin-bottom:22px}.mini-bar{padding:9px 14px;color:#111512;font-size:13px;border-radius:5px;background:#aab5ab;margin-top:12px;width:90%;font-weight:600}.mini-bar.after{width:44%;background:#c7fa72;min-width:100px}.mini-flow{display:flex;gap:10px}.mini-flow span{border:1px solid #596954;border-radius:6px;flex:1;text-align:center;padding:20px 5px;font-size:13px}.cover-diagram>p{font:10px 'JetBrains Mono Variable',monospace;color:#ffc477;margin-top:20px}
 @media(max-width:650px){.portfolio-grid{grid-template-columns:1fr;gap:22px}.card-content{padding:24px}.card-content h3{font-size:26px}.card-outcome{flex-wrap:wrap;gap:10px}.cover-diagram{padding:24px 24px 20px 54px}.cover-diagram>span{font-size:8px;margin-bottom:16px}.mini-flow span{padding:12px 5px}}
 @media(prefers-reduced-motion:reduce){.portfolio-card:hover,.portfolio-card:hover .card-cover img{transform:none}}
</style>

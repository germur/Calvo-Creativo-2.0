---
import { cases } from '@/src/cases';
---
<div class="grid md:grid-cols-2 gap-6">
{cases.map((item,index) => <a href={`/casos/${item.slug}`} class="group block border-2 border-ink bg-white p-6 md:p-8 shadow-brutal-sm hover:border-primary transition-colors">
<div class="flex justify-between gap-4 mb-5 font-mono text-xs uppercase"><span class="text-primary">{item.category}</span><span aria-hidden="true">0{index+1} ↗</span></div>
<p class="font-mono text-sm mb-3">{item.client}</p><h3 class="font-display text-3xl md:text-4xl leading-tight mb-4 group-hover:text-primary">{item.title}</h3><p class="text-gray-700 leading-relaxed mb-6">{item.summary}</p>
<div class="border-t-2 border-ink pt-4"><p class="font-display text-3xl">{item.signal}</p><p class="text-sm text-gray-600 mt-1">{item.label}</p></div><p class="mt-6 font-mono text-sm font-bold underline decoration-primary underline-offset-4">Leer el caso →</p>
</a>)}
</div>
